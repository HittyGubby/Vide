    { "type": "playlist", "platform": "netease" },
    { "type": "lyrics", "platform": "netease" },
    { "type": "search", "platform": "tencent" },
    { "type": "resolve", "platform": "tencent" },
    { "type": "stream", "platform": "tencent" },
    { "type": "playlist", "platform": "tencent" },
    { "type": "lyrics", "platform": "tencent" },
    { "type": "search", "platform": "kugou" },
    { "type": "resolve", "platform": "kugou" },
    { "type": "stream", "platform": "kugou" },
    { "type": "playlist", "platform": "kugou" },
    { "type": "lyrics", "platform": "kugou" },
    { "type": "search", "platform": "kuwo" },
    { "type": "resolve", "platform": "kuwo" },
    { "type": "stream", "platform": "kuwo" },
    { "type": "playlist", "platform": "kuwo" },
    { "type": "lyrics", "platform": "kuwo" }
  ]
