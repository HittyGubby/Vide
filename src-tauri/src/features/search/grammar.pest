// ── Vide Search Query Grammar ───────────────────────────────────────
//
// Supported query syntax:
//   country:russia                  // tag filter
//   playlist:"My List!"            // tag filter (quote values with spaces)
//   title CONTAINS "hello"          // text filter
//   title CONTAINS hello            // bare (unquoted) value, one word
//   song_metadata CONTAINS "a b"    // title/artist/album, all words (AND)
//   genre:pop AND mood:dark         // boolean AND
//   country:russia OR genre:pop     // boolean OR
//   NOT genre:pop                   // negation
//   (a OR b) AND c                  // grouping
//   hello world                     // bare text: implicit AND of
//                                   // song_metadata CONTAINS terms
//
// CONTAINS is loose by design: words are matched case- and
// diacritic-insensitively, and every word must match (AND).
//
// Values may be quoted or bare. A bare value runs until whitespace or a
// parenthesis, so symbols such as "!" inside a playlist name (for example
// playlist:Best!) are ordinary characters instead of boolean operators.
// Only a leading "!" or a standalone NOT starts a negation.

query = { SOI ~ expr ~ EOI }
expr = { or_expr }

or_expr  = { and_expr ~ (or_op ~ and_expr)* }
and_expr = { atom ~ (and_op ~ atom | implicit_and)* }

// Keyword boundary checks must be atomic: implicit whitespace would
// otherwise be skipped before the assertion, making "OR b" fail the check.
or_op  = @{ ^"OR" ~ !ident_char }
and_op = @{ ^"AND" ~ !ident_char }

// Whitespace-separated terms are an implicit AND (SQL-like).
implicit_and = _{ !(or_op | and_op) ~ atom }

atom = { paren_expr | not_expr | filter | bare_filter }

paren_expr = { "(" ~ expr ~ ")" }
not_expr   = { not_op ~ atom }
not_op     = @{ ("!") | (^"NOT" ~ !ident_char) }

filter = { tag_filter | text_filter | cmp_filter }

tag_filter = { ident ~ ":" ~ tag_value }
tag_value  = { quoted_string | bare_value }

text_filter = { field ~ contains_op ~ query_value }
contains_op = @{ ^"CONTAINS" ~ !ident_char }

cmp_filter = { field ~ cmp_op ~ query_value }
cmp_op = { ">=" | "<=" | "!=" | "=" | ">" | "<" }

// A bare word is shorthand for song_metadata CONTAINS <word>.
bare_filter = { quoted_string | bare_value }

field = {
    "song_metadata" | "tags"
    | "id" | "title" | "artist" | "album" | "source" | "source_id" | "path"
    | "file_name" | "notes" | "lyrics"
    | "added_time" | "duration" | "play_count"
}

query_value = { quoted_string | bare_value }

ident = @{ (ASCII_ALPHA | ASCII_DIGIT | "_" | "-" | ".")+ }
ident_char = _{ ASCII_ALPHANUMERIC | "_" | "-" | "." }

// Unquoted values keep every character except whitespace, parentheses and
// quotes. This is what makes playlist:Hello! and playlist:歌单 work.
bare_value = @{ bare_char+ }
bare_char = _{ !(" " | "\t" | "\r" | "\n" | "(" | ")" | "\"") ~ ANY }

quoted_string = @{ "\"" ~ (escape | (!("\"" | "\\") ~ ANY))* ~ "\"" }
escape = @{ "\\" ~ ANY }

WHITESPACE = _{ " " | "\t" }
